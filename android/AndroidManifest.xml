<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.pixeldeity.app"
    android:versionCode="29"
    android:versionName="7.6.0">

  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>

  <!-- Until now this manifest had NO uses-permission element at all, so the
       APK could not open a socket. That was correct while the game was
       entirely offline; it is not now that the ground can be streamed.
       The permission is not sufficient on its own — the app also loads from
       file://, and that is the other half of why it cannot stream yet. Where
       imagery is unavailable the renderer draws the procedural globe, which
       is a complete picture rather than an error state. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

  <application
      android:label="Pixel Deity"
      android:icon="@drawable/icon"
      android:hardwareAccelerated="true"
      android:allowBackup="true"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="sensorLandscape"
        android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
